rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Uploaded entry photos (achievements, storyboarding, concepts, ...).
    // Public read so visitors can see the portfolio; write requires a
    // signed-in account. The only account that can ever sign in is the one
    // created manually in the console (see ADMIN_SETUP.md) -- there is no
    // public sign-up flow in this app -- so an authenticated request here is
    // equivalent to an admin request, mirroring the Realtime Database rules.
    match /entry-media/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
